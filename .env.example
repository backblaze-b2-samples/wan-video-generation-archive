# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# The region in your bucket's S3 endpoint, e.g. s3.<region>.backblazeb2.com.
# The endpoint itself is derived from it, so there is no endpoint variable.
B2_REGION=your-b2-region

# Optional: public base URL for objects, only when the bucket is public.
# Share links are presigned and never need it.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.<region>.backblazeb2.com

# Example of what filled-in values look like (fake, for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K005EXAMPLE_NOT_A_REAL_APP_KEY
# B2_BUCKET_NAME=my-video-archive
# B2_REGION=us-west-004

# --- Video generation (all optional) ---
# Pinned model id: wan2.2-ti2v-5b (default, 24 GB+ CUDA GPU) or
# wan2.1-t2v-1.3b (local development, fits smaller GPUs and Apple MPS).
# WAN_MODEL=wan2.2-ti2v-5b
# auto = CUDA, then Apple MPS, then CPU (CPU works but is very slow). Or cuda|mps|cpu.
# WAN_DEVICE=auto
# auto = model CPU offload on when the CUDA GPU has < 40 GB VRAM. Or on|off.
# WAN_CPU_OFFLOAD=auto
# Both pinned models are public; a token only raises Hugging Face rate limits.
# HF_TOKEN=
# Where model weights are cached; put it on fast local disk on the GPU host.
# HF_HOME=/path/to/hf-cache
# If set, must be https://huggingface.co; any mirror is refused.
# HF_ENDPOINT=https://huggingface.co

# --- Clip lifecycle (optional) ---
# The age job archives clips at least this many days old.
# ARCHIVE_AFTER_DAYS=30
# Default share link lifetime in seconds (clamped to 60..604800).
# SHARE_LINK_TTL_SECONDS=3600

# Frontend -> API base URL. Defaults to http://localhost:8000 for local dev.
# Next.js inlines it at build time, so it must be present when `pnpm build` runs.
# NEXT_PUBLIC_API_URL=https://your-api.example.com
